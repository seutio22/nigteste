# Build a partir da RAIZ do monorepo — evita "Could not find root directory: portal-api"
# quando o Root Directory no Railway fica vazio e o Dockerfile é este ficheiro.
# Mantém o mesmo runtime que portal-api/Dockerfile (contexto = conteúdo de portal-api/).
FROM node:22-alpine

RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build"

COPY portal-api/package.json ./
COPY portal-api/prisma.config.ts ./
COPY portal-api/prisma ./prisma

ENV NPM_CONFIG_PRODUCTION=false

RUN npm install

COPY portal-api/tsconfig.json ./
COPY portal-api/src ./src

RUN npx prisma generate && npm run build

ENV NODE_ENV=production

EXPOSE 4001

CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
