{
  "buildCommand": "rm -rf dist node_modules/.vite && npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://nigteste-production.up.railway.app"
  }
}
