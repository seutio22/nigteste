/// Planos por fornecedor (Dados → Placement → Planos). Usado no mapeamento de itens (categoria por operadora).
model PlacementPlano {
  id                   String   @id @default(uuid())
  operadoraId          String
  categoria            String
  plano                String
  reembolso            String?
  eventosReembolsaveis String?
  acomodacao           String?
  abrangencia          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  operadora Operadora @relation(fields: [operadoraId], references: [id], onDelete: Cascade)
  diferenciais PlacementDiferencial[]

