model User {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  password             String?
  passwordUpdatedAt    DateTime?             @default(now())
  role                 String                @default("analista")
  /**
   * Área/departamento (cadastro em Dados → Áreas). Opcional.
   */
  departmentId         String?
  department           Area?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  active               Boolean               @default(true)
  viewOwnDataOnly      Boolean               @default(false)
  permissions          String?
  lastLogin            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  atendimentos         Atendimento[]
  comunicados          Comunicado[]
  demandas             Demanda[]
  manutencoes          Manutencao[]
  managedProjects      Project[]             @relation("ProjectManager")
  ownedProjects        Project[]             @relation("ProjectOwner")
  projectMembers       ProjectMember[]       @relation("ProjectMember")
  reajustes            Reajuste[]
  reajustesManutencao  ReajusteManutencao[]
  reajusteLancamentos  ReajusteLancamento[]
  userPermissions      UserPermission[]
  validacoes           Validacao[]
  validacoesManutencao ValidacaoManutencao[]
  timelineEvents       TimelineEvent[]
  projectWorkAuditLogs ProjectWorkAuditLog[]
  projectTemplates     ProjectTemplate[]
  userActivities       UserActivity[]
  userSessions         UserSession[]
  userMonitoring       UserMonitoring[]
  deletionLogs         DeletionLog[]
  projectAlerts        ProjectAlert[]
  placementCotacoes    PlacementCotacao[]
}

model KanbanTicket {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String
  priority    String
  assignee    String? // Campo string sem constraint de chave estrangeira
  startDate   DateTime?
  dueDate     DateTime?
  tags        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TimelineEvent {
  id         String   @id @default(uuid())
  entityId   String // ID da entidade (demanda, reajuste, etc.)
  entityType String // Tipo da entidade (demanda, reajuste, atendimento, analytics)
  eventType  String // Tipo do evento (create, field_change, status_change, comment)
  field      String? // Campo alterado (para field_change)
  fromValue  String? // Valor anterior
  toValue    String? // Valor novo
  comment    String? // Comentário (para comment)
  userId     String? // ID do usuário que fez a alteração
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  userEmail String
  userRole  String
  action    String // login, logout, page_view, api_call, etc.
  page      String? // Página acessada
  endpoint  String? // Endpoint da API chamado
  ipAddress String?
  userAgent String?
  sessionId String?
  duration  Int? // Duração em segundos
  metadata  String? // Dados adicionais em JSON
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, action, createdAt])
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  sessionId    String    @unique
  ipAddress    String?
  userAgent    String?
  loginTime    DateTime  @default(now())
  logoutTime   DateTime?
  lastActivity DateTime  @default(now())
  isActive     Boolean   @default(true)
  duration     Int? // Duração total em segundos
  pageViews    Int       @default(0)
  apiCalls     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
}

model UserMonitoring {
  id                   String   @id @default(uuid())
  userId               String
  date                 DateTime @default(now())
  totalTimeToday       Int      @default(0) // em minutos
  totalTimeThisWeek    Int      @default(0) // em minutos
  totalTimeThisMonth   Int      @default(0) // em minutos
  totalTimeThisQuarter Int      @default(0) // em minutos
  sessionCount         Int      @default(0)
  loginCount           Int      @default(0)
  logoutCount          Int      @default(0)
  pageViewCount        Int      @default(0)
  apiCallCount         Int      @default(0)
  /**
   * Soma do tempo (segundos) registrado via action page_time neste dia
   */
  pageDwellSeconds     Int      @default(0)
  /**
   * Quantidade de encerramentos de permanência (eventos page_time) neste dia
   */
  pageDwellSessions    Int      @default(0)
  averageSessionTime   Int      @default(0) // em minutos
  lastAccess           DateTime @default(now())
  isOnline             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

// Tabela para histórico de exclusões (Soft Delete)
model DeletionLog {
  id         String   @id @default(uuid())
  entityType String // Tipo da entidade: 'demanda', 'manutencao', 'analytics', etc.
  entityId   String // ID do item excluído
  deletedBy  String // ID do usuário que excluiu
  deletedAt  DateTime @default(now())
  reason     String? // Motivo da exclusão (opcional)
  user       User     @relation(fields: [deletedBy], references: [id])

  @@index([entityType, deletedAt])
  @@index([deletedBy])
}
