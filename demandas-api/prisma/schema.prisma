generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  // Forçar encoding UTF-8
  relationMode = "prisma"
}

model Area {
  id           String        @id @default(uuid())
  nome         String
  descricao    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  atendimentos Atendimento[]
  demandas     Demanda[]
  manutencoes  Manutencao[]
  users        User[]
}

model Analista {
  id                   String                @id @default(uuid())
  nome                 String
  email                String?
  telefone             String?
  cargo                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  atendimentos         Atendimento[]
  demandas             Demanda[]
  manutencoes          Manutencao[]
  assignedSubtasks     ProjectSubtask[]
  assignedTasks        ProjectTask[]
  reajustes            Reajuste[]
  reajustesManutencao  ReajusteManutencao[]
  reajusteLancamentos  ReajusteLancamento[]
  validacoes           Validacao[]
  validacoesManutencao ValidacaoManutencao[]
  placementCotacoes    PlacementCotacao[]
}

model Operadora {
  id           String        @id @default(uuid())
  nome         String
  cnpj         String?       @unique
  telefone     String?
  email        String?
  endereco     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  atendimentos Atendimento[]
  demandas     Demanda[]
  manutencoes  Manutencao[]
  produtos     Produto[]
  validacoes   Validacao[]
  placementLogo PlacementOperadoraLogo?
  placementPlanos PlacementPlano[]
  placementDiferenciais PlacementDiferencial[]
}

/// Logo da operadora (fornecedor) para apresentações Placement — cadastro em Dados → Placement.
model PlacementOperadoraLogo {
  id           String   @id @default(uuid())
  operadoraId  String   @unique
  nomeOriginal String
  storedName   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  operadora Operadora @relation(fields: [operadoraId], references: [id], onDelete: Cascade)
}

model Produto {
  id           String        @id @default(uuid())
  nome         String
  descricao    String?
  operadoraId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  atendimentos Atendimento[]
  demandas     Demanda[]
  manutencoes  Manutencao[]
  operadora    Operadora?    @relation(fields: [operadoraId], references: [id])
  validacoes   Validacao[]
}

model Sistema {
  id           String        @id @default(uuid())
  nome         String
  descricao    String?
  versao       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  atendimentos Atendimento[]
  demandas     Demanda[]
  manutencoes  Manutencao[]
}

model Grupo {
  id        String   @id @default(uuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id                String             @id @default(uuid())
  nome              String
  grupoEconomico    String?
  cnpj              String?            @unique
  telefone          String?
  email             String?
  endereco          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  atendimentos      Atendimento[]
  contratos         Contrato[]
  demandas          Demanda[]
  manutencoes       Manutencao[]
  projects          Project[]
  validacoes        Validacao[]
  placementCotacoes PlacementCotacao[]
}

model Contrato {
  id             String        @id @default(uuid())
  numero         String
  codigo         String?
  grupoEconomico String?
  clienteId      String?
  valor          Float?
  dataInicio     DateTime?
  dataFim        DateTime?
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  atendimentos   Atendimento[]
  cliente        Cliente?      @relation(fields: [clienteId], references: [id])
  demandas       Demanda[]
  manutencoes    Manutencao[]
  validacoes     Validacao[]
}

model TipoServico {
  id           String        @id @default(uuid())
  nome         String
  descricao    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  atendimentos Atendimento[]
  demandas     Demanda[]
  padroes      Padrao[]
}

model Padrao {
  id            String       @id @default(uuid())
  nome          String
  tipoServicoId String?
  /// Quando false, o padrão não aparece nas caixas de seleção (Dados → Padrão controla isso)
  ativo         Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tipoServico   TipoServico? @relation(fields: [tipoServicoId], references: [id])
  manutencoes   Manutencao[]
}

model TipoDemanda {
  id           String        @id @default(uuid())
  nome         String
  descricao    String?
  /// Quando false, o tipo não aparece no formulário de nova demanda (cadastro)
  ativo        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  atendimentos Atendimento[]
  demandas     Demanda[]
}

model TipoCadastro {
  id          String       @id @default(uuid())
  nome        String
  descricao   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  manutencoes Manutencao[]
}

model Demanda {
  id                    String       @id @default(uuid())
  status                String       @default("Pendente")
  ticket                String?
  analistaId            String?
  userId                String?
  solicitante           String?
  areaId                String?
  tipoId                String?
  descricao             String?
  clienteId             String?
  contratoId            String?
  operadoraId           String?
  produtoId             String?
  tipoServicoId         String?
  sistemaId             String?
  /// Lista de IDs de sistemas (multi-seleção); `sistemaId` espelha o primeiro para compatibilidade
  sistemasIds           Json?
  /// Métricas por sistema (key = sistemaId): { qtdUsuarios?: number, qtdClientesVinculados?: number }
  /// Não substitui os campos legados (qtdUsuarios/qtdClientesVinculados/usuariosEmpresa); serve para o novo fluxo multi-sistema.
  sistemasMetrics       Json?
  dataInicio            DateTime?
  dataFinal             DateTime?
  qtdUsuarios           String?
  qtdRetornos           Int?
  qualidade             String?
  /// Qualificação da recepção do chamado (checklist do analista)
  qualificacaoChamado   Json?
  observacoes           String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  qtdClientesVinculados Int?
  usuariosEmpresa       Int?
  sistema               Sistema?     @relation(fields: [sistemaId], references: [id])
  tipoServico           TipoServico? @relation(fields: [tipoServicoId], references: [id])
  produto               Produto?     @relation(fields: [produtoId], references: [id])
  operadora             Operadora?   @relation(fields: [operadoraId], references: [id])
  contrato              Contrato?    @relation(fields: [contratoId], references: [id])
  cliente               Cliente?     @relation(fields: [clienteId], references: [id])
  tipo                  TipoDemanda? @relation(fields: [tipoId], references: [id])
  area                  Area?        @relation(fields: [areaId], references: [id])
  user                  User?        @relation(fields: [userId], references: [id])
  analista              Analista?    @relation(fields: [analistaId], references: [id])
  reajustes             Reajuste[]
  validacoes            Validacao[]
}

model Manutencao {
  id              String                @id @default(uuid())
  status          String                @default("Pendente")
  ticket          String?               @unique
  analistaId      String?
  userId          String?
  solicitante     String?
  areaId          String?
  tipoId          String?
  descricao       String?
  clienteId       String?
  contratoId      String?
  /// Lista de IDs de contratos (multi-seleção); `contratoId` espelha o primeiro para compatibilidade
  contratosIds    Json?
  /// Vínculo por linha: contrato + operadora + produto (e-mail Comunicar)
  contratosVinculos Json?
  operadoraId     String?
  produtoId       String?
  tipoServicoId   String?
  sistemaId       String?
  /// Lista de IDs de sistemas (multi-seleção); `sistemaId` espelha o primeiro para compatibilidade
  sistemasIds     Json?
  /// Totais por sistema (key = sistemaId): number
  sistemasTotais  Json?
  dataInicio      DateTime?
  dataFinal       DateTime?
  qtdRetornos     Int?
  qualidade       String?
  total           Int? // Total (anteriormente qtdClientesVinculados)
  usuariosEmpresa Int? // USUÁRIOS EMPRESA - MOVE
  observacoes     String?
  qualificacaoChamado Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sistema         Sistema?              @relation(fields: [sistemaId], references: [id])
  tipoServico     TipoCadastro?         @relation(fields: [tipoServicoId], references: [id])
  produto         Produto?              @relation(fields: [produtoId], references: [id])
  operadora       Operadora?            @relation(fields: [operadoraId], references: [id])
  contrato        Contrato?             @relation(fields: [contratoId], references: [id])
  cliente         Cliente?              @relation(fields: [clienteId], references: [id])
  tipo            Padrao?               @relation(fields: [tipoId], references: [id])
  area            Area?                 @relation(fields: [areaId], references: [id])
  user            User?                 @relation(fields: [userId], references: [id])
  analista        Analista?             @relation(fields: [analistaId], references: [id])
  reajustes       ReajusteManutencao[]
  validacoes      ValidacaoManutencao[]
}

model Atendimento {
  id                  String       @id @default(uuid())
  ticket              String?      @unique
  titulo              String?
  descricao           String?
  status              String       @default("Aberto")
  prioridade          String       @default("Média")
  categoria           String?
  solicitante         String?
  emailSolicitante    String?
  telefoneSolicitante String?
  analistaId          String?
  userId              String?
  areaId              String?
  clienteId           String?
  contratoId          String?
  operadoraId         String?
  produtoId           String?
  sistemaId           String?
  tipoServicoId       String?
  tipoId              String?
  dataAbertura        DateTime     @default(now())
  dataResolucao       DateTime?
  dataFechamento      DateTime?
  tempoResolucao      Int?
  satisfacao          Int?
  comentarios         String?
  anexos              String?
  tags                String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tipo                TipoDemanda? @relation(fields: [tipoId], references: [id])
  tipoServico         TipoServico? @relation(fields: [tipoServicoId], references: [id])
  sistema             Sistema?     @relation(fields: [sistemaId], references: [id])
  produto             Produto?     @relation(fields: [produtoId], references: [id])
  operadora           Operadora?   @relation(fields: [operadoraId], references: [id])
  contrato            Contrato?    @relation(fields: [contratoId], references: [id])
  cliente             Cliente?     @relation(fields: [clienteId], references: [id])
  area                Area?        @relation(fields: [areaId], references: [id])
  user                User?        @relation(fields: [userId], references: [id])
  analista            Analista?    @relation(fields: [analistaId], references: [id])
}

model Mailling {
  id                     String    @id @default(uuid())
  nome                   String
  email                  String    @unique
  telefone               String?
  empresa                String?
  cargo                  String?
  departamento           String?
  categoria              String
  status                 String    @default("Ativo")
  origem                 String?
  tags                   String?
  observacoes            String?
  dataCadastro           DateTime  @default(now())
  ultimoEnvio            DateTime?
  totalEnvios            Int       @default(0)
  aberturas              Int       @default(0)
  cliques                Int       @default(0)
  // Novos campos para suportar todos os dados do frontend
  posicaoEmail           String? // PARA, CÓPIA, CÓPIA OCULTA
  grupos                 String? // JSON array de IDs
  filiais                String? // JSON array de IDs
  area                   String? // ID da área
  cancelamento           String? // sim/nao
  alteracaoContratual    String? // sim/nao
  alteracaoDadosCliente  String? // sim/nao
  alteracaoServicos      String? // sim/nao
  alteracaoRemuneracao   String? // sim/nao
  curadoriaPortalRh      String? // sim/nao
  documentacaoContratual String? // sim/nao
  changeLog              String? // JSON array de alterações
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Analytics {
  id                   String   @id @default(uuid())
  tipo                 String
  categoria            String
  periodo              String
  metricas             String
  totalDemandas        Int      @default(0)
  totalAtendimentos    Int      @default(0)
  totalValidacoes      Int      @default(0)
  totalReajustes       Int      @default(0)
  demandasAbertas      Int      @default(0)
  demandasFechadas     Int      @default(0)
  atendimentosAbertos  Int      @default(0)
  atendimentosFechados Int      @default(0)
  tempoMedioResolucao  Float?
  satisfacaoMedia      Float?
  analistaMaisAtivo    String?
  areaMaisAtiva        String?
  clienteMaisAtivo     String?
  operadoraMaisAtiva   String?
  produtoMaisUsado     String?
  sistemaMaisUsado     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Report {
  id              String    @id @default(uuid())
  titulo          String
  descricao       String?
  ticket          String?
  total           String?
  tipo            String    @default("mensal")
  status          String    @default("PENDENTE")
  analista        String
  area            String?
  cliente         String?
  contrato        String?
  dataInicio      DateTime?
  dataFinalizacao DateTime?
  dataEntrega     DateTime?
  prioridade      String    @default("media")
  solicitante     String?
  solicitacao     String?
  tipoSolicitacao String?
  tipoServico     String?
  observacoes     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Dados {
  id            String    @id @default(uuid())
  tipo          String
  chave         String    @unique
  valor         String
  descricao     String?
  categoria     String?
  ativo         Boolean   @default(true)
  dataInicio    DateTime  @default(now())
  dataFim       DateTime?
  criadoPor     String?
  atualizadoPor String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Solicitante {
  id        String   @id @default(uuid())
  nome      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Relatorio {
  id        String   @id @default(uuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Modelo {
  id        String   @id @default(uuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AreaMailling {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CargoMailling {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FilialMailling {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dashboard {
  id               String            @id @default(uuid())
  usuarioId        String
  nome             String
  tipo             String
  layout           String
  widgets          String
  filtros          String?
  ativo            Boolean           @default(true)
  padrao           Boolean           @default(false)
  ordem            Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dashboardWidgets DashboardWidget[]
}

model DashboardWidget {
  id           String    @id @default(uuid())
  dashboardId  String
  tipo         String
  titulo       String
  configuracao String
  posicaoX     Int
  posicaoY     Int
  largura      Int
  altura       Int
  ativo        Boolean   @default(true)
  ordem        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  dashboard    Dashboard @relation(fields: [dashboardId], references: [id])
}

model Validacao {
  id              String     @id @default(uuid())
  demandaId       String? // Tornado opcional para permitir validações independentes
  analistaId      String
  userId          String?
  status          String     @default("Aberta")
  dataInicio      DateTime?
  dataFim         DateTime?
  observacoes     String?
  // Campos para cliente, contrato e operadora
  clienteId       String?
  contratoId      String?
  operadoraId     String?
  produtoId       String?
  // Campos adicionais do formulário
  ticket          String?    @unique
  solicitante     String?
  tipo            String?
  descricao       String?
  qualidade       String?
  qtdRetornos     Int?
  vigencia        String?
  // Novos campos para estruturas EDGE, MOVE e formalização
  estruturaEdge   String? // Tipo de erro na estrutura EDGE (JSON array)
  estruturaMove   String? // Tipo de erro na estrutura MOVE (JSON array)
  formalizacao    String? // Status de formalização
  // Novos campos para itens
  itensPendentes  Int? // Quantidade de itens pendentes
  itensConcluidos Int? // Quantidade de itens concluídos
  total           Float? // Total calculado automaticamente
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User?      @relation(fields: [userId], references: [id])
  analista        Analista   @relation(fields: [analistaId], references: [id])
  demanda         Demanda?   @relation(fields: [demandaId], references: [id]) // Relacionamento opcional
  cliente         Cliente?   @relation(fields: [clienteId], references: [id])
  contrato        Contrato?  @relation(fields: [contratoId], references: [id])
  operadora       Operadora? @relation(fields: [operadoraId], references: [id])
  produto         Produto?   @relation(fields: [produtoId], references: [id])
}

model Reajuste {
  id                  String    @id @default(uuid())
  demandaId           String
  analistaId          String?
  userId              String?
  responsavelAnalista String?
  valorAnterior       Float?
  valorNovo           Float?
  percentual          Float?
  motivo              String?
  aprovado            Boolean   @default(false)
  dataAprovacao       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User?     @relation(fields: [userId], references: [id])
  analista            Analista? @relation(fields: [analistaId], references: [id])
  demanda             Demanda   @relation(fields: [demandaId], references: [id])
}

model ReajusteLancamento {
  id                  String    @id @default(uuid())
  mes                 String
  ano                 String
  dataInicio          DateTime?
  dataFim             DateTime?
  status              String
  operadora           String
  qualidade           String?
  qualidadeInformacao String?
  planos              String?
  responsavelConta    String?
  filial              String?
  ticket              String?
  solicitante         String?
  responsavelAnalista String
  cliente             String?
  contrato            String?
  produto             String?
  contratosVinculos   Json?
  dataAtualizacao     DateTime?
  itensPendentes      Int?
  itensConcluidos     Int?
  valorTotal          Float?
  descricao           String?
  tipoReajuste        String?
  percentual          Float?
  dataAplicacao       DateTime?
  observacoes         String?
  analistaId          String?
  userId              String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  analista            Analista? @relation(fields: [analistaId], references: [id])
  user                User?     @relation(fields: [userId], references: [id])
}

model ValidacaoManutencao {
  id              String     @id @default(uuid())
  manutencaoId    String
  analistaId      String
  userId          String?
  status          String     @default("Pendente")
  dataInicio      DateTime?
  dataFim         DateTime?
  observacoes     String?
  // Novos campos para estruturas EDGE, MOVE e formalização
  estruturaEdge   String? // Tipo de erro na estrutura EDGE (JSON array)
  estruturaMove   String? // Tipo de erro na estrutura MOVE (JSON array)
  formalizacao    String? // Status de formalização
  // Novos campos para itens
  itensPendentes  Int? // Quantidade de itens pendentes
  itensConcluidos Int? // Quantidade de itens concluídos
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User?      @relation(fields: [userId], references: [id])
  analista        Analista   @relation(fields: [analistaId], references: [id])
  manutencao      Manutencao @relation(fields: [manutencaoId], references: [id])
}

model ReajusteManutencao {
  id                  String     @id @default(uuid())
  manutencaoId        String
  analistaId          String?
  userId              String?
  responsavelAnalista String?
  valorAnterior       Float?
  valorNovo           Float?
  percentual          Float?
  motivo              String?
  aprovado            Boolean    @default(false)
  dataAprovacao       DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User?      @relation(fields: [userId], references: [id])
  analista            Analista?  @relation(fields: [analistaId], references: [id])
  manutencao          Manutencao @relation(fields: [manutencaoId], references: [id])
}

model Project {
  id              String                  @id @default(uuid())
  name            String
  description     String
  status          String
  priority        String
  startDate       DateTime
  endDate         DateTime
  progress        Int                     @default(0)
  budget          Float?
  clientId        String?
  managerId       String?
  ownerId         String?
  team            String
  tags            String
  color           String
  isPrivate       Boolean                 @default(false)
  timeline        String?                 @default("{}")
  activities      String?                 @default("[]")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  manager         User?                   @relation("ProjectManager", fields: [managerId], references: [id])
  owner           User?                   @relation("ProjectOwner", fields: [ownerId], references: [id])
  client          Cliente?                @relation(fields: [clientId], references: [id])
  externalMembers ProjectExternalMember[]
  members         ProjectMember[]
  milestones      ProjectMilestone[]
  shareTokens     ProjectShareToken[]
  tasks           ProjectTask[]
  timelines       ProjectTimeline[]
  alerts          ProjectAlert[]
  workAuditLogs   ProjectWorkAuditLog[]
}

/// Template reutilizável de cronograma (etapas, tarefas e subtarefas) para novos projetos.
model ProjectTemplate {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  timeline    String   @default("{}")
  ownerId     String?
  isGlobal    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

/// Histórico de alterações em etapas (fases), tarefas e subtarefas — base para indicadores e auditoria.
model ProjectWorkAuditLog {
  id          String   @id @default(uuid())
  projectId   String
  entityType  String
  entityId    String?
  action      String
  actorUserId String?
  targetLabel String?
  metadata    String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([projectId, entityType, action])
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  role        String
  permissions String?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
