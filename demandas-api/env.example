# Configurações de Ambiente
NODE_ENV=production
PORT=3333

# Banco de Dados
DATABASE_URL="postgresql://username:password@localhost:5432/demandas_db"

# JWT
JWT_SECRET="sua-chave-secreta-super-segura-aqui"

# CORS (front em produção + opcionais)
FRONTEND_URL="https://seu-frontend.vercel.app"
# Origens extras separadas por vírgula ou ponto e vírgula (previews, outro domínio).
# CORS_ORIGINS="https://nigteste-abc123.vercel.app,https://homolog.exemplo.com"
# Previews Vercel (*.vercel.app) — use só se aceitar qualquer preview nesse sufixo.
# CORS_ALLOW_VERCEL_PREVIEWS=1

# Consulta CNPJ (Placement — proxy no servidor; padrão BrasilAPI pública)
# BRASILAPI_CNPJ_BASE_URL="https://brasilapi.com.br/api/cnpj/v1"
# BRASILAPI_CNPJ_TIMEOUT_MS=15000

# Anexos de subfatura Placement (volume persistente no host, ex. Railway disk mount)
# PLACEMENT_UPLOADS_DIR="/data/uploads"

# Logs
LOG_LEVEL=info
