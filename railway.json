{
  "$schema": "https://railway.app/railway.schema.json",
  "$service": {
    "rootDirectory": "demandas-api"
  },
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "npm run railway:start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
