{
  "version": 2,
  "builds": [
    {
      "src": "demandas-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://nigteste-production.up.railway.app"
  },
  "buildCommand": "cd demandas-web && npm run build"
}