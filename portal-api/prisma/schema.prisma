// Banco PostgreSQL exclusivo do portal do colaborador (separado do Nexus / demandas-api)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Colaborador ou gestor do lado solicitante (não confundir com User do Nexus)
enum PortalUserRole {
  COLLABORATOR
  /// Vê solicitações dos colaboradores vinculados (direct reports)
  REQUESTER_MANAGER
  /// Atende fila operacional (triagem, atribuição)
  PORTAL_OPERATOR
  /// Acesso ao painel de configuração do portal (áreas, formulários, usuários)
  PORTAL_ADMIN
}

model PortalUser {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String
  role            PortalUserRole   @default(COLLABORATOR)
  active          Boolean          @default(true)
  /// Gestor responsável por este colaborador (hierarquia solicitante)
  parentManagerId String?
  parentManager   PortalUser?      @relation("UserReports", fields: [parentManagerId], references: [id])
  directReports   PortalUser[]     @relation("UserReports")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cases           PortalCase[]     @relation("CaseRequester")
  assignedCases   PortalCase[]     @relation("CaseAssignee")
}

/// Abas / agrupamentos no portal (configuráveis)
model PortalArea {
  id        String               @id @default(uuid())
  slug      String               @unique
  name      String
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  types     PortalRequestType[]
  cases     PortalCase[]
}

/// Catálogo de campos alinhados ao Nexus / integração (mapeamento nos formulários do portal)
enum NexusFieldValueType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

/// Snapshot dos dados mestres vindos da API Nexus (página Dados) — atualizado por sync
model PortalNexusEntitySnapshot {
  /// Mesma chave usada no Nexus web (ex.: clientes, tiposDemanda)
  entityKey String   @id
  rows      Json     @default("[]")
  rowCount  Int      @default(0)
  syncedAt  DateTime?
  lastError String?
  updatedAt DateTime @updatedAt
}

model PortalNexusField {
  id          String              @id @default(uuid())
  /// Chave técnica única (ex.: titulo, id_cliente) — usada no mapeamento do formulário
  key         String              @unique
  label       String
  description String?
  valueType   NexusFieldValueType @default(TEXT)
  /// Para valueType SELECT: lista de valores permitidos no Nexus
  enumOptions Json?
  sortOrder   Int                 @default(0)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

/// Perfil de SLA parametrizável (triagem, atuação, pausa com demandante, adicional pós-retorno)
model PortalSlaProfile {
  id        String @id @default(uuid())
  slug      String @unique
  name      String
  /// Descrição interna / observações
  description String?
  sortOrder Int    @default(0)
  active    Boolean @default(true)
  /// Prazo da fase de triagem (minutos)
  slaTriagemMinutos Int
  /// Prazo da fase de atuação / análise (minutos)
  slaAtuacaoMinutos Int
  /// Minutos adicionais somados após o demandante responder (retorno de pausa)
  minutosAdicionalAposRetornoDemanda Int @default(0)
  /// Enquanto aguarda o demandante (itens adicionais), o relógio de SLA fica pausado
  pausarQuandoAguardandoDemanda Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requestTypes PortalRequestType[]
}

/// Tipo de requisição por área (cada um terá formulário + SLA no futuro)
model PortalRequestType {
  id         String      @id @default(uuid())
  areaId     String
  area       PortalArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  active     Boolean     @default(true)
  /// Definição do formulário dinâmico (JSON) — evolução autogerencial
  formSchema Json?
  slaProfileId String?
  slaProfile   PortalSlaProfile? @relation(fields: [slaProfileId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cases      PortalCase[]

  @@unique([areaId, slug])
}

enum PortalCaseStatus {
  DRAFT
  SUBMITTED
  IN_TRIAGE
  IN_ANALYSIS
  AWAITING_REQUESTER
  AWAITING_THIRD_PARTY
  COMPLETED
  CANCELLED
}

enum PortalCasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PortalCase {
  id               String             @id @default(uuid())
  protocol         String             @unique
  status           PortalCaseStatus   @default(DRAFT)
  priority         PortalCasePriority @default(MEDIUM)
  /// Subfila / classificação operacional (ex. N1, Jurídico)
  queueLabel       String?
  portalUserId     String
  user             PortalUser         @relation("CaseRequester", fields: [portalUserId], references: [id], onDelete: Cascade)
  assignedToUserId String?
  assignee         PortalUser?        @relation("CaseAssignee", fields: [assignedToUserId], references: [id])
  areaId           String?
  area             PortalArea?        @relation(fields: [areaId], references: [id])
  requestTypeId    String?
  requestType      PortalRequestType? @relation(fields: [requestTypeId], references: [id])
  title            String?
  /// Payload das respostas do formulário (versão congelada no envio)
  answers          Json?
  /// Referência ao registro criado/atualizado no Nexus (quando integrar)
  nexusRef         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
