// Banco PostgreSQL exclusivo do portal do colaborador (separado do Nexus / demandas-api)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Colaborador ou gestor do lado solicitante (não confundir com User do Nexus)
enum PortalUserRole {
  COLLABORATOR
  /// Vê solicitações dos colaboradores vinculados (direct reports)
  REQUESTER_MANAGER
  /// Atende fila operacional (triagem, atribuição)
  PORTAL_OPERATOR
  /// Acesso ao painel de configuração do portal (áreas, formulários, usuários)
  PORTAL_ADMIN
}

model PortalUser {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String
  role            PortalUserRole   @default(COLLABORATOR)
  active          Boolean          @default(true)
  /// Gestor responsável por este colaborador (hierarquia solicitante)
  parentManagerId String?
  parentManager   PortalUser?      @relation("UserReports", fields: [parentManagerId], references: [id])
  directReports   PortalUser[]     @relation("UserReports")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// Último login bem-sucedido (POST /auth/login)
  lastLogin       DateTime?
  /// Última atividade conhecida (ex.: GET /auth/me ao abrir o portal)
  lastSeenAt      DateTime?
  /// Atualizado ao criar conta, trocar senha no admin ou registo
  passwordUpdatedAt DateTime       @default(now())
  cases           PortalCase[]     @relation("CaseRequester")
  assignedCases   PortalCase[]     @relation("CaseAssignee")
}

// --- Cadastros de seguros (base para abertura de solicitações) ---

enum PortalApoliceProduto {
  SAUDE
  ODONTO
  VIDA_GRUPO
  OUTROS
}

/// Modelo de cadastro alargado na página «Dados do seguro» (plano estruturado vs coberturas).
enum PortalApoliceModeloDadosSeguro {
  PLANO
  COBERTURA
}

/// Por linha de plano: custo único (médio) ou tabela por faixa etária.
enum PortalApoliceTipoCustoPlano {
  CUSTO_MEDIO
  FAIXA_ETARIA
}

/// Estado cadastral da empresa subestipulante ligada à apólice (guarda-chuva).
enum PortalSubestipulanteStatus {
  ATIVO
  CANCELADO
}

/// Cone geográfico (time de relacionamento).
enum PortalSeguroConeRegiao {
  NORTE
  SUL
}

/// Catálogo de operadoras / seguradoras (opções persistidas no portal).
model PortalSeguroOperadora {
  id        String   @id @default(uuid())
  nome      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  apolices  PortalSeguroApolice[]

  @@index([active, sortOrder, nome])
}

/// Cliente consolidado (Nexus ou histórico) vs. possível cliente futuro (cadastro interno).
enum PortalGrupoEconomicoClassificacao {
  CLIENTE
  PROSPECT
}

/// Cliente / grupo econômico (nível 1)
model PortalGrupoEconomico {
  id              String                           @id @default(uuid())
  nome            String
  cnpj            String?
  observacoes     String?
  classificacao   PortalGrupoEconomicoClassificacao @default(CLIENTE)
  active          Boolean                          @default(true)
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  estipulantes    PortalSeguroEstipulante[]

  @@index([nome])
  @@index([classificacao])
}

/// Estipulante vinculado a um grupo econômico (nível 2)
model PortalSeguroEstipulante {
  id                   String                @id @default(uuid())
  /// Grupo local (opcional); o fluxo Nexus usa `grupoEconomicoNome`.
  grupoEconomicoId     String?
  grupo                PortalGrupoEconomico? @relation(fields: [grupoEconomicoId], references: [id], onDelete: SetNull)
  /// Nome do grupo econômico alinhado ao Nexus (`Cliente.grupoEconomico`); permite vários CNPJs no mesmo grupo.
  grupoEconomicoNome   String
  nexusClienteId       String?
  razaoSocial          String
  cnpj                 String
  /** Classificação Nacional de Atividades Económicas (opcional). */
  cnae                 String?
  nomeFantasia         String?
  observacoes          String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  /** Quando preenchido, indica criação pela importação Nexus→portal. */
  importadoNexusEm     DateTime?
  apolices             PortalSeguroApolice[]

  @@index([grupoEconomicoId])
  @@index([grupoEconomicoNome])
  @@unique([grupoEconomicoNome, cnpj])
}

/// Apólice vinculada ao estipulante (nível 3)
model PortalSeguroApolice {
  id              String                    @id @default(uuid())
  estipulanteId   String
  estipulante     PortalSeguroEstipulante   @relation(fields: [estipulanteId], references: [id], onDelete: Cascade)
  /// Quando preenchido, corresponde ao `id` do registo no snapshot Nexus `contratos`.
  nexusContratoId String?
  numeroApolice   String
  produto         PortalApoliceProduto
  /// Nome da operadora (denormalizado; alinhar com `operadora.nome` quando houver FK).
  fornecedor      String
  operadoraId     String?
  operadora       PortalSeguroOperadora? @relation(fields: [operadoraId], references: [id], onDelete: SetNull)
  /// Resumo legado (ex.: primeira razão social); detalhe em `subestipulantes`.
  subestipulante  String?
  plano           String?
  coberturas      String?
  vigenciaInicio  DateTime?
  vigenciaFim     DateTime?
  observacoes     String?
  active          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  /** Quando preenchido, indica criação pela importação Nexus→portal (não sobrescrito em re-importações). */
  importadoNexusEm DateTime?
  /// Plano estruturado (várias linhas) vs coberturas — ver página «Dados do seguro» no portal.
  modeloDadosSeguro PortalApoliceModeloDadosSeguro?
  itens           PortalSeguroApoliceItem[]
  planoLinhas     PortalSeguroApolicePlanoLinha[]
  subestipulantes PortalSeguroApoliceSubestipulante[]
  faturasMensais  PortalSeguroApoliceFaturaMes[]

  comissionamento PortalSeguroApoliceComissionamento?
  fee             PortalSeguroApoliceFee?

  trCone               PortalSeguroConeRegiao?
  trDiretoria          String?
  trSuperintendente    String?
  trGerente            String?
  trExecutivoConsultor String?
  trAnalista           String?

  @@index([estipulanteId])
  @@index([nexusContratoId])
  @@index([operadoraId])
  @@unique([estipulanteId, numeroApolice])
}

/// Comissionamento parcelado (12 parcelas em JSON) por apólice — no máximo um por apólice.
model PortalSeguroApoliceComissionamento {
  id                        String              @id @default(uuid())
  apoliceId                 String              @unique
  apolice                   PortalSeguroApolice @relation(fields: [apoliceId], references: [id], onDelete: Cascade)
  temCorretorParceiro       Boolean?            @default(false)
  valorAgenciamentoContrato Decimal?            @db.Decimal(14, 2)
  valorVitalicioContrato    Decimal?            @db.Decimal(14, 2)
  /// JSON: array de 12 percentuais (consultoria — agenciamento)
  agenciamentoConsultoria   String?             @db.Text
  /// JSON: array de 12 percentuais (consultoria — vitalício)
  vitalicioConsultoria      String?             @db.Text
  agenciamentoCorretor      String?             @db.Text
  vitalicioCorretor         String?             @db.Text
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([apoliceId])
}

/// Valores de fee (mensal / consultoria / parceiro) — no máximo um por apólice.
model PortalSeguroApoliceFee {
  id                  String              @id @default(uuid())
  apoliceId           String              @unique
  apolice             PortalSeguroApolice @relation(fields: [apoliceId], references: [id], onDelete: Cascade)
  valorFeeMensal      Decimal?            @db.Decimal(14, 2)
  feeConsultoria      Decimal?            @db.Decimal(14, 2)
  feeCorretorParceiro Decimal?            @db.Decimal(14, 2)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([apoliceId])
}

/// Vidas e valor de fatura por competência (mês/ano) — aba financeira da apólice.
model PortalSeguroApoliceFaturaMes {
  id             String              @id @default(uuid())
  apoliceId      String
  apolice        PortalSeguroApolice @relation(fields: [apoliceId], references: [id], onDelete: Cascade)
  competenciaAno Int
  competenciaMes Int
  vidas          Int                 @default(0)
  valorFatura    Decimal             @db.Decimal(14, 2)
  observacoes    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([apoliceId, competenciaAno, competenciaMes])
  @@index([apoliceId])
}

/// Um registo de plano dentro da apólice (pode haver vários). Custos: médio ou por faixa etária (JSON com chaves fixas).
model PortalSeguroApolicePlanoLinha {
  id              String                       @id @default(uuid())
  apoliceId       String
  apolice         PortalSeguroApolice          @relation(fields: [apoliceId], references: [id], onDelete: Cascade)
  sortOrder       Int                          @default(0)
  codigoPlano     String
  tipoCusto       PortalApoliceTipoCustoPlano
  custoMedio      Decimal?                     @db.Decimal(14, 4)
  valoresPorFaixa Json?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([apoliceId, sortOrder])
}

/// Empresas subestipulantes vinculadas à apólice (mesmo guarda-chuva / contrato).
model PortalSeguroApoliceSubestipulante {
  id           String                   @id @default(uuid())
  apoliceId    String
  apolice      PortalSeguroApolice       @relation(fields: [apoliceId], references: [id], onDelete: Cascade)
  sortOrder    Int                      @default(0)
  razaoSocial  String
  cnpj         String
  codigoSub    String
  status       PortalSubestipulanteStatus @default(ATIVO)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([apoliceId, sortOrder])
}

enum PortalSeguroItemTipo {
  COBERTURA
  SERVICO
  CLAUSULA
  OUTRO
}

/// Itens ligados à apólice: coberturas, serviços, cláusulas etc. (nível 4)
model PortalSeguroApoliceItem {
  id          String              @id @default(uuid())
  apoliceId   String
  apolice     PortalSeguroApolice @relation(fields: [apoliceId], references: [id], onDelete: Cascade)
  tipo        PortalSeguroItemTipo
  descricao   String
  detalhes    String?
  sortOrder   Int                 @default(0)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([apoliceId, sortOrder])
}

/// Abas / agrupamentos no portal (configuráveis)
model PortalArea {
  id        String               @id @default(uuid())
  slug      String               @unique
  name      String
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  types     PortalRequestType[]
  cases     PortalCase[]
}

/// Catálogo de campos alinhados ao Nexus / integração (mapeamento nos formulários do portal)
enum NexusFieldValueType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

/// Snapshot dos dados mestres vindos da API Nexus (página Dados) — atualizado por sync
model PortalNexusEntitySnapshot {
  /// Mesma chave usada no Nexus web (ex.: clientes, tiposDemanda)
  entityKey String   @id
  rows      Json     @default("[]")
  rowCount  Int      @default(0)
  syncedAt  DateTime?
  lastError String?
  updatedAt DateTime @updatedAt
}

model PortalNexusField {
  id          String              @id @default(uuid())
  /// Chave técnica única (ex.: titulo, id_cliente) — usada no mapeamento do formulário
  key         String              @unique
  label       String
  description String?
  valueType   NexusFieldValueType @default(TEXT)
  /// Para valueType SELECT: lista de valores permitidos no Nexus
  enumOptions Json?
  sortOrder   Int                 @default(0)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

/// Lista reutilizável no portal (ex.: filiais, categorias) — itens geridos pelo admin, sem código
model PortalLookupList {
  id          String             @id @default(uuid())
  /// Chave única (ex.: filiais)
  key         String             @unique
  label       String
  description String?
  sortOrder   Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       PortalLookupItem[]
}

model PortalLookupItem {
  id        String           @id @default(uuid())
  listId    String
  list      PortalLookupList @relation(fields: [listId], references: [id], onDelete: Cascade)
  label     String
  /// Valor guardado nas respostas do formulário (estável, ex. slug)
  value     String
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([listId, sortOrder])
  @@unique([listId, value])
}

/// Perfil de SLA parametrizável (triagem, atuação, pausa com demandante, adicional pós-retorno)
model PortalSlaProfile {
  id        String @id @default(uuid())
  slug      String @unique
  name      String
  /// Descrição interna / observações
  description String?
  sortOrder Int    @default(0)
  active    Boolean @default(true)
  /// Se true, os prazos abaixo em dias úteis (seg–sex); se false, usa os campos em minutos (calendário)
  prazoEmDiasUteis Boolean @default(true)
  /// Prazo da fase de triagem em dias úteis (quando prazoEmDiasUteis)
  triagemDiasUteis Int @default(1)
  /// Prazo da fase de atuação em dias úteis
  atuacaoDiasUteis Int @default(5)
  /// Dias úteis adicionais após o demandante responder (retorno de pausa)
  adicionalDiasUteisAposRetorno Int @default(0)
  /// Prazo da fase de triagem (minutos) — legado / modo calendário
  slaTriagemMinutos Int
  /// Prazo da fase de atuação / análise (minutos)
  slaAtuacaoMinutos Int
  /// Minutos adicionais somados após o demandante responder (retorno de pausa)
  minutosAdicionalAposRetornoDemanda Int @default(0)
  /// Enquanto aguarda o demandante (itens adicionais), o relógio de SLA fica pausado
  pausarQuandoAguardandoDemanda Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requestTypes PortalRequestType[]
}

/// Tipo de requisição por área (cada um terá formulário + SLA no futuro)
model PortalRequestType {
  id         String      @id @default(uuid())
  areaId     String
  area       PortalArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  active     Boolean     @default(true)
  /// Definição do formulário dinâmico (JSON) — evolução autogerencial
  formSchema Json?
  slaProfileId String?
  slaProfile   PortalSlaProfile? @relation(fields: [slaProfileId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cases      PortalCase[]

  @@unique([areaId, slug])
}

enum PortalCaseStatus {
  DRAFT
  SUBMITTED
  IN_TRIAGE
  IN_ANALYSIS
  AWAITING_REQUESTER
  AWAITING_THIRD_PARTY
  COMPLETED
  CANCELLED
}

enum PortalCasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PortalCase {
  id               String             @id @default(uuid())
  protocol         String             @unique
  status           PortalCaseStatus   @default(DRAFT)
  priority         PortalCasePriority @default(MEDIUM)
  /// Subfila / classificação operacional (ex. N1, Jurídico)
  queueLabel       String?
  portalUserId     String
  user             PortalUser         @relation("CaseRequester", fields: [portalUserId], references: [id], onDelete: Cascade)
  assignedToUserId String?
  assignee         PortalUser?        @relation("CaseAssignee", fields: [assignedToUserId], references: [id])
  areaId           String?
  area             PortalArea?        @relation(fields: [areaId], references: [id])
  requestTypeId    String?
  requestType      PortalRequestType? @relation(fields: [requestTypeId], references: [id])
  title            String?
  /// Payload das respostas do formulário (versão congelada no envio)
  answers          Json?
  /// Referência ao registro criado/atualizado no Nexus (quando integrar)
  nexusRef         String?
  /// Momento em que a solicitação foi enviada (início do SLA)
  slaSubmittedAt   DateTime?
  /// Prazo limite da fase de triagem
  slaTriagemDueAt  DateTime?
  /// Prazo limite da fase de atuação (após triagem)
  slaAtuacaoDueAt  DateTime?
  /// Início da pausa enquanto aguarda o demandante
  slaPausedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
