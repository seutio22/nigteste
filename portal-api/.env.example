# PostgreSQL exclusivo do portal (local ou Railway).
# Produção: projeto Railway "amusing-flexibility" (Postgres do portal + API). Não perpetual-imagination.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/portal_colaborador?schema=public"

# Segredo JWT (gere uma string longa aleatória em produção)
JWT_SECRET="troque-em-producao"

# Opcional: expiração do token (ex.: 7d, 24h)
# JWT_EXPIRES_IN="7d"

# Porta da API (Railway define PORT automaticamente)
# PORT=4001

# Origens CORS separadas por vírgula (sem barra no fim). Ex.: front Vercel + dev local
# CORS_ORIGIN="https://portal-web-psi.vercel.app,http://localhost:5174"
CORS_ORIGIN="http://localhost:5174"

# Seed: administrador do portal (npx prisma db seed)
# PORTAL_ADMIN_EMAIL="admin@suaempresa.com"
# PORTAL_ADMIN_PASSWORD="senha-forte-aqui"
# PORTAL_ADMIN_NAME="Administrador"

# Sincronização com a API Nexus (demandas) — mesmos GET da página Dados
# Passo a passo: portal-api/NEXUS-RAILWAY.md
# Resumo: npx @railway/cli login  →  cd portal-api  →
#   .\configure-nexus-railway.ps1 -BaseUrl "URL_API_DEMANDAS" -Token "JWT"
# URL pública da API demandas (sem barra no fim)
# NEXUS_API_BASE_URL="https://sua-api-demandas.up.railway.app"
# JWT de um usuário Nexus com leitura dos cadastros
# NEXUS_API_TOKEN="eyJhbG..."

# Sincronização automática em background (minutos). Padrão 15 — ideal para não sobrecarregar a API Nexus.
# Use 30 se os cadastros mudam pouco; mínimo efetivo 5. 0 = desliga só o agendador (sync manual continua).
# NEXUS_SYNC_INTERVAL_MINUTES="15"
# Opcional: rodar uma sync 15 s após o deploy (útil para popular listas logo ao subir)
# NEXUS_SYNC_ON_STARTUP="true"

# --- Anexos baratos: Cloudflare R2 (não usa espaço do Postgres; ~$0.015/GB-mês + egress grátis para a Internet)
# Dashboard Cloudflare → R2 → criar bucket → "Manage R2 API Tokens" (Object Read & Write).
# No bucket → Settings → CORS: Allowed origins = URL do teu front; Methods GET, PUT, HEAD; Headers *
# R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET_NAME="portal-anexos"
# Opcional: limite documental (MB) comunicado ao front; o PUT real valida no CORS/tamanho no R2 se configurares
# R2_MAX_FILE_MB="25"
